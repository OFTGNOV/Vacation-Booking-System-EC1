<?xml version="1.0"?>
<configuration>
	<appSettings>
		<add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
	</appSettings>
  <connectionStrings>
    <!-- CHANGE THIS to the SQL Server instance used by your group. -->
    <add name="DefaultConnection"
         connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=JTBVacationBooking;Integrated Security=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <system.web>
    <compilation debug="true" targetFramework="4.7.2" />
    <httpRuntime targetFramework="4.7.2" />
    <authentication mode="Forms">
      <forms loginUrl="Login.aspx" timeout="30" slidingExpiration="true" />
    </authentication>
    <sessionState mode="InProc" timeout="30" />
    <customErrors mode="RemoteOnly" />
  </system.web>
</configuration>
